        "reveal": {"progress": "outExpo(t / 0.3)", "angle": -90}},
       {"type": "text", "text": "OF TIME", "font": "fonts/EBGaramond-SemiBold.ttf", "font_size": 130, "color": "#14131a",
        "position": [540, 1100], "box": "ink", "start": 1.1,
        "glyphs": {"opacity": "clamp((t - i * 0.05) / 0.15, 0, 1)", "offset": [0, "36 * (1 - outBack(clamp((t - i * 0.05) / 0.35, 0, 1)))"]}}
     ]},

