{
  "width": 1080, "height": 1920, "fps": 30, "duration": 9, "background": "#14131a",
  "layers": [
    {"type": "shader", "name": "sky", "params": {"top": "#1d1b2a", "bottom": "#3a3150", "glow": "#e8b27a"},
