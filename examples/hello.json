      {"type": "text", "text": "IN ANY ORDER", "font": "fonts/EBGaramond-SemiBold.ttf", "font_size": 44, "color": "#6b5a7a",
       "position": [540, 1120], "start": 1.6, "tracking": 0.32, "opacity": "clamp(t / 0.4, 0, 1)"},
      {"type": "rect", "size": [1080, 1920], "color": "#ffffff", "duration": 0.35, "opacity": "pow(1 - t / 0.35, 2) * 0.9"}
